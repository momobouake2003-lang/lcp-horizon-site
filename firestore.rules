rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Rôles admin ---
    // Un utilisateur est administrateur si le document users/{uid} existe
    // et contient role: "admin". Ce document ne peut être créé/modifié que
    // depuis la console Firebase (jamais depuis le site).
    function estAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    // Nécessaire pour que admin.js puisse lire son propre document de rôle
    // (getDoc côté client, pour afficher/masquer le dashboard).
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /reservations/{id} {
      allow create: if request.resource.data.keys().hasAll(['nom','prenom','email','telephone','dateAller','mode','statut'])
                    && request.resource.data.nom is string
                    && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() < 100
                    && request.resource.data.prenom is string
                    && request.resource.data.prenom.size() > 0 && request.resource.data.prenom.size() < 100
                    && request.resource.data.email is string
                    && request.resource.data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
                    && request.resource.data.telephone is string
                    && request.resource.data.telephone.size() > 0 && request.resource.data.telephone.size() < 30
                    && request.resource.data.dateAller is string
                    && request.resource.data.mode in ['direct', 'demande']
                    && request.resource.data.statut == 'en_attente';
      allow read, update, delete: if estAdmin();
    }

    match /vols/{id} {
      allow read: if true;
      allow write: if estAdmin();
    }

    // Manquait entièrement : sans cette règle, la lecture du catalogue
    // produits depuis Firestore échoue toujours (repli silencieux sur le
    // catalogue statique local côté client, donc invisible sans y regarder).
    match /produitsNaturels/{id} {
      allow read: if true;
      allow write: if estAdmin();
    }
  }
}
